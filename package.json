{
  "name": "blendtune",
  "packageManager": "pnpm@10.26.2",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "build": "vite build --config main/apps/web/vite.config.ts",
    "start": "node node_modules/tsx/dist/cli.mjs main/apps/server/src/main.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:watch": "eslint . --ext .js,.jsx,.ts,.tsx --watch",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dry": "tsx scripts/migrate.ts --dry-run",
    "db:status": "tsx scripts/db-status.ts",
    "dev:api": "tsx watch main/apps/server/src/main.ts",
    "start:api": "tsx main/apps/server/src/main.ts",
    "dev:web": "vite --config main/apps/web/vite.config.ts",
    "build:web": "vite build --config main/apps/web/vite.config.ts",
    "preview:web": "vite preview --config main/apps/web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@reduxjs/toolkit": "^2.14.0",
    "argon2": "^0.45.2",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.8",
    "lodash": "^4.18.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "postgres": "^4.1.0",
    "rc-slider": "^11.1.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.6"
  },
  "pnpm": {
    "overrides": {
      "browserslist": "4.28.4",
      "caniuse-lite": "1.0.30001800",
      "@typescript-eslint/types": "8.72.1",
      "@typescript-eslint/tsconfig-utils": "8.72.1"
    }
  }
}
